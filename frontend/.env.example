# Copy to .env.local (gitignored) and fill in from Firebase console ->
# Project settings -> Your apps -> Web app. The web config is not secret, but
# it stays out of git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to use the local Auth emulator (npm run emulator) instead of Firebase.
# VITE_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099

# Development only: where the FastAPI backend runs. Defaults to :8000.
# BACKEND_URL=http://localhost:8000

# Only when the frontend is deployed on a different origin from the API.
# VITE_API_BASE=https://api.example.com
