# Copy to backend/.env (gitignored). Every value has a default in src/config.py
# except the two secrets-in-practice below.

# Groq API key. Without it every agent falls back to its rule-based engine.
GROQ_API_KEY=
GROQ_MODEL="openai/gpt-oss-120b"

# Firebase project id: the API verifies sign-in tokens against it. No
# service-account key is needed.
FIREBASE_PROJECT_ID=

QDRANT_URL="http://localhost:6333"
REDIS_URL="redis://localhost:6379/0"
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/whatlawsays"
